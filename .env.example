# ASPIRE-GAC SRHR Intelligence & Performance Platform
#
# Every value here is optional. With none of them set the platform seeds itself
# with a clearly-labelled demo dataset and runs end to end.

# ---------------------------------------------------------------------------
# Session security — REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# At least 32 characters. The server refuses to start a session in production
# without it rather than signing with a known development value.
ASPIRE_SESSION_SECRET=

# Password for the seeded accounts created on first run. Set this before any
# deployment; otherwise a documented development password is used and the
# sign-in screen says so.
ASPIRE_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Any PostgreSQL works; on Vercel, install Neon
# from the Marketplace and this is provisioned automatically.
#
#   Local development:  postgres://aspire:aspire@127.0.0.1:55433/aspire
#   Neon:               postgres://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
#
# POSTGRES_URL and DATABASE_POSTGRES_URL are also accepted, so a Marketplace
# integration that sets either of those works without further configuration.
DATABASE_URL=

# Connections held per serverless instance. Instances are numerous and
# short-lived, so this stays small.
DATABASE_POOL_MAX=5

# Separate database for the test suite. Each suite creates and drops its own
# schema, so this may point at the same server as DATABASE_URL.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# DHIS2 — set these to switch from demo data to live reporting
# ---------------------------------------------------------------------------
# Base URL of the DHIS2 instance, without a trailing slash. Include the
# context path: the national instance serves DHIS2 under /dhis.
#   DHIS2_BASE_URL=https://staging.dhis2nigeria.org.ng/dhis
DHIS2_BASE_URL=

# Prefer a personal access token. Basic auth is supported for instances that
# do not issue tokens. Credentials are read on the server only and are never
# sent to the browser or written to the audit log.
DHIS2_TOKEN=
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_TIMEOUT_MS=30000

# The org units whose subtrees are imported, comma-separated. Defaults to the
# DHIS2 user's data view org units — on the national instance, Bauchi and
# Sokoto — so this is only needed to narrow or override that.
#   DHIS2_ROOT_ORG_UNITS=ziJ3yxfgb3m,Gq37IyyjUfj
DHIS2_ROOT_ORG_UNITS=

# How DHIS2's numeric org-unit levels map onto the canonical hierarchy.
# DHIS2 levels have no fixed meaning — they depend on how the instance was
# built. The national instance is Federal → State → LGA → Ward → Facility,
# which is the default (1:COUNTRY,2:STATE,3:LGA,4:WARD,5:FACILITY). A level
# left out is skipped and its children attach to the nearest mapped ancestor,
# e.g. for a state-rooted instance with a community tier:
#   DHIS2_LEVEL_MAP=1:STATE,2:LGA,3:WARD,5:FACILITY
DHIS2_LEVEL_MAP=

# The quarter pages open on when none is chosen. By default it is the latest
# quarter the top of the hierarchy has data for, recorded at each sync. Pin it
# when that quarter is only partly reported, e.g. to the last full quarter:
#   ASPIRE_DEFAULT_PERIOD=2025Q4
ASPIRE_DEFAULT_PERIOD=

# Indicator UIDs for the national instance ship in src/config/indicators.ts.
# On an existing installation, run `npm run registry:apply-sources` to copy
# them into the database, then `npm run sync`. Unmapped indicators are skipped
# and reported rather than silently returning nothing.

# ---------------------------------------------------------------------------
# Geography
# ---------------------------------------------------------------------------
# Boundaries for the Map. Gombe State's eleven LGAs ship with the platform at
# public/geo/gombe-lgas.geojson (geoBoundaries gbOpen NGA ADM2, source GRID3,
# CC BY 4.0), so the map draws real geography with no configuration.
#
# Point this at another GeoJSON FeatureCollection to cover a different state or
# a national deployment. Each feature needs an `orgUnitId` (or `id`) property
# matching an organisation unit. Ring winding is normalised on load, so data
# that follows the GeoJSON specification works as-is.
ASPIRE_BOUNDARIES_PATH=

# ---------------------------------------------------------------------------
# Language-model assistance — off unless explicitly authorised
# ---------------------------------------------------------------------------
# Both of the following are required before anything is sent to an external
# model. Even then the model only chooses a query shape and phrases findings the
# platform has already computed and validated; it never calculates a figure and
# never sees raw observations. With this off, the platform still answers every
# question, using its own analytical engine and templates.
ASPIRE_AI_ENABLED=false
AI_GATEWAY_API_KEY=

# Months kept for the monthly summary, ending with the latest complete quarter
# (0–36, default 12). 0 turns monthly synchronisation off.
ASPIRE_MONTHLY_HISTORY=
