# ASPIRE-GAC SRHR Intelligence & Performance Platform
#
# Every value here is optional. With none of them set the platform seeds itself
# with a clearly-labelled demo dataset and runs end to end.

# ---------------------------------------------------------------------------
# Session security — REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# At least 32 characters. The server refuses to start a session in production
# without it rather than signing with a known development value.
ASPIRE_SESSION_SECRET=

# Password for the seeded accounts created on first run. Set this before any
# deployment; otherwise a documented development password is used and the
# sign-in screen says so.
ASPIRE_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite file. Defaults to .data/aspire.db under the working directory.
ASPIRE_DB_PATH=

# ---------------------------------------------------------------------------
# DHIS2 — set these to switch from demo data to live reporting
# ---------------------------------------------------------------------------
# Base URL of the DHIS2 instance, without a trailing slash.
# The target instance for this deployment is:
#   DHIS2_BASE_URL=https://dhis2.hiva.chat
DHIS2_BASE_URL=

# Prefer a personal access token. Basic auth is supported for instances that
# do not issue tokens. Credentials are read on the server only and are never
# sent to the browser or written to the audit log.
DHIS2_TOKEN=
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_TIMEOUT_MS=30000

# How DHIS2's numeric org-unit levels map onto the canonical hierarchy.
# DHIS2 levels have no fixed meaning — they depend on how the instance was
# built. The Gombe State instance is State → LGA → Ward → Community → Facility,
# which is the default. Override for a differently-shaped instance, e.g. a
# national one:
#   DHIS2_LEVEL_MAP=1:COUNTRY,2:STATE,3:LGA,4:FACILITY
DHIS2_LEVEL_MAP=

# After setting these, map each remaining indicator to its DHIS2 identifier in
# Admin → Indicators, then run `npm run sync`. Five indicators already carry
# real UIDs from the target instance; unmapped ones are skipped and reported
# rather than silently returning nothing.

# ---------------------------------------------------------------------------
# Geography
# ---------------------------------------------------------------------------
# Boundaries for the Map. Gombe State's eleven LGAs ship with the platform at
# public/geo/gombe-lgas.geojson (geoBoundaries gbOpen NGA ADM2, source GRID3,
# CC BY 4.0), so the map draws real geography with no configuration.
#
# Point this at another GeoJSON FeatureCollection to cover a different state or
# a national deployment. Each feature needs an `orgUnitId` (or `id`) property
# matching an organisation unit. Ring winding is normalised on load, so data
# that follows the GeoJSON specification works as-is.
ASPIRE_BOUNDARIES_PATH=

# ---------------------------------------------------------------------------
# Language-model assistance — off unless explicitly authorised
# ---------------------------------------------------------------------------
# Both of the following are required before anything is sent to an external
# model. Even then the model only chooses a query shape and phrases findings the
# platform has already computed and validated; it never calculates a figure and
# never sees raw observations. With this off, the platform still answers every
# question, using its own analytical engine and templates.
ASPIRE_AI_ENABLED=false
AI_GATEWAY_API_KEY=
